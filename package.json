{
  "name": "kinfold",
  "version": "0.6.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "A local memory your coding agents share: Claude Code, OpenCode, Codex and Cursor.",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/dashboard",
    "daemon": "bun src/controllers/daemon/main.ts",
    "hook": "bun src/controllers/cli/hook.ts",
    "observe": "bun src/resources/observer/once.ts",
    "kinfold": "bun src/controllers/cli/kinfold.ts",
    "mcp": "bun src/controllers/mcp/server.ts",
    "dashboard": "bun src/controllers/cli/kinfold.ts dashboard",
    "build:release": "bun tools/build-release.ts",
    "changeset": "changeset",
    "dashboard:build": "bun --bun node_modules/vite/bin/vite.js build --config src/ui/dashboard/vite.config.ts",
    "dashboard:dev": "bun --bun node_modules/vite/bin/vite.js build --watch --config src/ui/dashboard/vite.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.25",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "happy-dom": "21.0.4",
    "lucide-react": "1.66.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "onnxruntime-web": "1.24.3"
  }
}
